<Application x:Class="WindowsToolkit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsToolkit"
             StartupUri="Views/LoginWindow.xaml">

    <Application.Resources>

        <SolidColorBrush x:Key="CorFundoPrincipal"
                         Color="#202124"/>

        <SolidColorBrush x:Key="CorMenuLateral"
                         Color="#2B2B2B"/>

        <SolidColorBrush x:Key="CorPainel"
                         Color="#3A3A3A"/>

        <SolidColorBrush x:Key="CorBotao"
                         Color="#3F3F3F"/>

        <SolidColorBrush x:Key="CorBotaoHover"
                         Color="#505050"/>

        <SolidColorBrush x:Key="CorDestaque"
                         Color="#00BCD4"/>

        <SolidColorBrush x:Key="CorTextoPrincipal"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="CorTextoSecundario"
                         Color="#CCCCCC"/>

        <Style x:Key="BotaoCorStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="54"/>

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="Margin"
                    Value="8"/>

            <Setter Property="Background"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

            <Setter Property="BorderBrush"
                    Value="#666666"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="27"/>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="BotaoTemaStyle"
       TargetType="Button">

            <Setter Property="Height"
            Value="70"/>

            <Setter Property="Margin"
            Value="8"/>

            <Setter Property="Background"
            Value="{DynamicResource CorPainel}"/>

            <Setter Property="Foreground"
            Value="{DynamicResource CorTextoPrincipal}"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="FontSize"
            Value="16"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                    x:Name="Borda"
                    Background="{TemplateBinding Background}"
                    CornerRadius="12">

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter
                            TargetName="Borda"
                            Property="Background"
                            Value="{DynamicResource CorBotaoHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter
                            TargetName="Borda"
                            Property="Opacity"
                            Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>
        

            <!-- Estilo dos botões comuns -->
        <Style x:Key="BotaoPadraoStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorBotao}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorTextoPrincipal}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                x:Name="BordaBotao"
                Background="{TemplateBinding Background}"
                CornerRadius="10">

                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Background"
                        Value="{DynamicResource CorBotaoHover}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Background"
                        Value="{DynamicResource CorBotao}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Opacity"
                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>

    
</Application>