<Page x:Class="WindowsToolkit.Views.ImpressorasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WindowsToolkit.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ImpressorasPage">

    <Page.Resources>

        <Style x:Key="BotaoPadraoStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="BordaBotao"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="BordaBotao"
                                    Property="Background"
                                    Value="#505050"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="BordaBotao"
                                    Property="Background"
                                    Value="#606060"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="BordaBotao"
                                    Property="Opacity"
                                    Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="#202124">

        <ScrollViewer
            x:Name="PainelFerramentas"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Width="420"
                HorizontalAlignment="Center"
                Margin="20,30">

                <TextBlock
                    Text="Ferramentas de Impressoras"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,25"/>

                <Button
                    Content="Exibir informações das impressoras"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Height="45"
                    Margin="0,5"
                    Click="BotaoInformacoesImpressoras_Click"/>

                <Button
                    Content="Reiniciar Spooler"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Height="45"
                    Margin="0,5"
                    Click="BotaoReiniciarSpooler_Click"/>

                <Button
                     Content="Limpar fila de impressão"
                     Style="{StaticResource BotaoPadraoStyle}"
                     Height="45"
                     Margin="0,5"
                     Click="BotaoLimparFila_Click"/>
                
                <Button
                    Content="Instalar impressora"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Height="45"
                    Margin="0,5"
                    Click="BotaoAdicionarImpressora_Click"/>    

            </StackPanel>

        </ScrollViewer>

        <Grid
            x:Name="PainelInformacoesImpressoras"
            Margin="25"
            Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Content="← Voltar"
                    Width="100"
                    Height="38"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Click="BotaoVoltar_Click"/>

                <TextBlock
                    Grid.Column="1"
                    Text="Informações das Impressoras"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <Button
                    Grid.Column="2"
                    Content="Atualizar"
                    Width="100"
                    Height="38"
                    Style="{StaticResource BotaoPadraoStyle}"
                    Click="BotaoAtualizarInformacoes_Click"/>
                

            </Grid>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">


                <ItemsControl x:Name="ListaImpressoras">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            

                            <Border
                                Background="#2B2B2B"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,15">
                                


                                <StackPanel>

                                    <TextBlock
                                        Text="{Binding Nome}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Margin="0,0,0,12"/>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="Status:"
                                            Foreground="#AAAAAA"/>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding Status}"
                                            Foreground="White"/>

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Text="Driver:"
                                            Foreground="#AAAAAA"/>

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding Driver}"
                                            Foreground="White"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Text="Porta:"
                                            Foreground="#AAAAAA"/>

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{Binding Porta}"
                                            Foreground="White"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Text="Padrão:"
                                            Foreground="#AAAAAA"/>

                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Text="{Binding Padrao}"
                                            Foreground="White"/>

                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Text="Compartilhada:"
                                            Foreground="#AAAAAA"/>

                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Text="{Binding Compartilhada}"
                                            Foreground="White"/>

                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Text="Compartilhamento:"
                                            Foreground="#AAAAAA"/>

                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Text="{Binding NomeCompartilhamento}"
                                            Foreground="White"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Text="Localização:"
                                            Foreground="#AAAAAA"/>

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Text="{Binding Localizacao}"
                                            Foreground="White"
                                            TextWrapping="Wrap"/>

                                    </Grid>

                                    <UniformGrid
                                        Columns="3"
                                        Margin="0,15,0,0">      

                                        <Button
                                            Content="Página de teste"
                                            Tag="{Binding Nome}"
                                            Style="{StaticResource BotaoPadraoStyle}"
                                            Margin="5"
                                            Click="BotaoImprimirTeste_Click"/>

                                        <Button
                                            Content="Definir padrão"
                                            Tag="{Binding Nome}"
                                            Style="{StaticResource BotaoPadraoStyle}"
                                            Margin="5"
                                            Click="BotaoDefinirPadrao_Click"/>

                                        <Button
                                            Content="Copiar dados"
                                            Tag="{Binding Nome}"
                                            Style="{StaticResource BotaoPadraoStyle}"
                                            Margin="5"
                                            Click="BotaoCopiarInformacoes_Click"/>

                                        <Button
                                            Content="Abrir fila"
                                            Tag="{Binding Nome}"
                                            Style="{StaticResource BotaoPadraoStyle}"
                                            Margin="5"
                                            Click="BotaoAbrirFila_Click"/>  

                                    </UniformGrid>
                                </StackPanel>

                            </Border>

                        </DataTemplate>
                        
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
