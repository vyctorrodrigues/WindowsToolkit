<Page x:Class="WindowsToolkit.Views.LimpezaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WindowsToolkit.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LimpezaPage">
    
    <Page.Resources>
        <Style x:Key="BotaoPadraoStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                x:Name="BordaBotao"
                Background="{TemplateBinding Background}"
                CornerRadius="10">

                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Background"
                        Value="#505050"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Background"
                        Value="#606060"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Opacity"
                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do botão de limpeza completa -->
        <Style x:Key="BotaoLimpezaCompletaStyle" TargetType="Button">
            <Setter Property="Background" Value="#C0504D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                x:Name="BordaBotao"
                Background="{TemplateBinding Background}"
                CornerRadius="10">

                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Background"
                        Value="#D06A67"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Background"
                        Value="#A84240"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                        TargetName="BordaBotao"
                        Property="Opacity"
                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>
    
    
    <Grid>
        <Border
            Background="#202124">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="320">

            <TextBlock
                x:Name="TextoConteudo"
                Text="Ferramentas de Limpeza"
                Foreground="White"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,25"/>

            <Button
                x:Name="BotaoLimpezaCompleta"
                Style="{StaticResource BotaoLimpezaCompletaStyle}"
                Content="⚡ Executar limpeza completa"
                Height="50"
                Margin="0,0,0,20"
                Click="BotaoLimpezaCompleta_Click"/>

            <ProgressBar
                x:Name="BarraProgressoLimpeza"
                Height="18"
                Minimum="0"
                Maximum="100"
                Value="0"
                Margin="0,0,0,8"
                Visibility="Collapsed"/>

            <TextBlock
                x:Name="TextoStatusLimpeza"
                Text=""
                Foreground="#CFCFCF"
                FontSize="13"
                HorizontalAlignment="Center"
                Margin="0,0,0,15"/>


            <Button
                Content="Limpar arquivos temporários"
                Style="{StaticResource BotaoPadraoStyle}"
                Height="45"
                Margin="0,5"
                Click="BotaoLimparTemp_Click"/>

            <Button
                Content="Limpar histórico do Executar"
                Style="{StaticResource BotaoPadraoStyle}"
                Height="45"
                Margin="0,5"
                Click="BotaoLimparExecutar_Click"/>

                <Button
                Content="Esvaziar Lixeira"
                Style="{StaticResource BotaoPadraoStyle}"
                Height="45"
                Margin="0,5"
                Click="BotaoLixeira_Click"/>


            </StackPanel>

        </Border>
    </Grid>
</Page>
