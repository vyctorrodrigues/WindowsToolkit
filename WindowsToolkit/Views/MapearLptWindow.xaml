<Window x:Class="WindowsToolkit.Views.MapearLptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapear porta LPT"
        Height="300"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#202124">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Mapear impressora para porta LPT"
            FontSize="22"
            FontWeight="Bold"
            Foreground="White"
            Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock
                Text="Porta:"
                Foreground="#CCCCCC"
                Margin="0,0,0,5"/>

            <ComboBox
                x:Name="ComboPorta"
                Height="35"
                SelectedIndex="0">

                <ComboBoxItem Content="LPT1"/>
                <ComboBoxItem Content="LPT2"/>
                <ComboBoxItem Content="LPT3"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock
                Text="Caminho da impressora compartilhada:"
                Foreground="#CCCCCC"
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="CampoCaminhoImpressora"
                Height="35"
                Padding="8"
                Text="\\SERVIDOR\IMPRESSORA"/>
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            Text="Exemplo: \\ZTECH-D-ADM-1\HP M125a ADM"
            Foreground="#AAAAAA"
            Margin="0,8,0,0"/>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Cancelar"
                Width="100"
                Height="38"
                Margin="0,0,10,0"
                Click="BotaoCancelar_Click"/>

            <Button
                Content="Mapear"
                Width="100"
                Height="38"
                Click="BotaoMapear_Click"/>
        </StackPanel>
    </Grid>
</Window>