<Window x:Class="WindowsToolkit.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Toolkit"
        Width="420"
        Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource CorFundoPrincipal}">

    <Border Margin="30"
            Padding="30"
            Background="{DynamicResource CorPainel}"
            CornerRadius="15">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Windows Toolkit"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource CorTextoPrincipal}"/>

            <TextBlock
                Grid.Row="1"
                Text="Acesso restrito"
                Margin="0,5,0,25"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource CorTextoSecundario}"/>

            <TextBlock
                Grid.Row="2"
                Text="Senha"
                Margin="0,0,0,7"
                Foreground="{DynamicResource CorTextoPrincipal}"/>

            <PasswordBox
                Grid.Row="3"
                x:Name="SenhaBox"
                KeyDown="SenhaBox_KeyDown"
                Height="36"
                Padding="8,4"
                FontSize="16"/>

            <Button
                Grid.Row="4"
                Content="Entrar"
                Height="42"
                Margin="0,25,0,0"
                Click="Entrar_Click"
                Style="{StaticResource BotaoTemaStyle}"/>

        </Grid>

    </Border>

</Window>