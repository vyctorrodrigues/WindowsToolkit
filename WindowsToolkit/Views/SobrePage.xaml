<Page x:Class="WindowsToolkit.Views.SobrePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource CorFundoPrincipal}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock
                    Text="Windows Toolkit"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="{DynamicResource CorTextoPrincipal}"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Versão 1.0.0"
                    Margin="0,5,0,20"
                    FontSize="16"
                    Foreground="{DynamicResource CorTextoSecundario}"
                    HorizontalAlignment="Center"/>

                <Border
                    Background="{DynamicResource CorPainel}"
                    CornerRadius="12"
                    Padding="20"
                    Width="650">

                    <StackPanel>

                        <TextBlock
                            Text="Ferramenta desenvolvida para auxiliar técnicos de suporte na execução de diagnósticos."
                            
                            FontSize="15"
                            Foreground="{DynamicResource CorTextoPrincipal}"/>

                        <Separator Margin="0,20"/>

                        <TextBlock
                            Text="Desenvolvido Por:"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource CorTextoPrincipal}"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="Vyctor Gonçalves"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource CorTextoPrincipal}"
                            HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <TextBlock
                    Margin="0,25,0,0"
                    Text="© 2026 Windows Toolkit"
                    Foreground="{DynamicResource CorTextoSecundario}"
                    HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>