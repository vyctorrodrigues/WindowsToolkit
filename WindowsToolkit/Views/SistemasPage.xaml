<Page x:Class="WindowsToolkit.Views.SistemasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SistemasPage">
    <Page.Resources>

        <Style x:Key="BotaoPadraoStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaBotao"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaBotao" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BordaBotao" Property="Background" Value="#606060"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BordaBotao" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="#202124">

        <!-- PAINEL PRINCIPAL DE BOTEES -->
        <ScrollViewer x:Name="PainelFerramentas" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="420" HorizontalAlignment="Center" Margin="20,30">

                <TextBlock Text="Ferramentas do Sistema"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <Button Content="Exibir informações do sistema"
                        Style="{StaticResource BotaoPadraoStyle}" Height="45" Margin="0,5"
                        Click="BotaoInformacoesSistema_Click"/>

                <Button Content="Executar SFC"
                        Style="{StaticResource BotaoPadraoStyle}" Height="45" Margin="0,5"
                        Click="BotaoExecutarSfc_Click"/>

                <Button Content="Executar DISM"
                        Style="{StaticResource BotaoPadraoStyle}" Height="45" Margin="0,5"
                        Click="BotaoExecutarDism_Click"/>

                <Button Content="Reiniciar Explorer"
                        Style="{StaticResource BotaoPadraoStyle}" Height="45" Margin="0,5"
                        Click="BotaoReiniciarExplorer_Click"/>

                <Button Content="Ativar Office (MAS)"
                        Style="{StaticResource BotaoPadraoStyle}" Height="45" Margin="0,5"
                        Click="BtnAtivarOffice_Click"/>

            </StackPanel>
        </ScrollViewer>

        <!-- PAINEL DE INFORMAÇÕES DO SISTEMA -->
        <Grid x:Name="PainelInformacoesSistema" Visibility="Collapsed" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Voltar" Width="100" Height="38"
                        Style="{StaticResource BotaoPadraoStyle}" Click="BotaoVoltar_Click"/>

                <TextBlock Grid.Column="1" Text="Informações do Sistema" FontSize="24"
                           FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Atualizar" Width="100" Height="38"
                        Style="{StaticResource BotaoPadraoStyle}" Click="BotaoAtualizar_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="#2B2B2B" BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Computador:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NomeComputador}" Foreground="White"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sistema:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SistemaOperacional}" Foreground="White"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Versão:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Versao}" Foreground="White"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Build:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Build}" Foreground="White"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Arquitetura:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Arquitetura}" Foreground="White"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Processador:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Processador}" Foreground="White" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Memória RAM:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MemoriaRam}" Foreground="White"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Tempo ligado:" Foreground="#AAAAAA"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TempoLigado}" Foreground="White"/>
                </Grid>
            </Border>
        </Grid>

        <!-- PAINEL DE DISCOS -->
        <Grid x:Name="PainelDiscos" Visibility="Collapsed" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Voltar" Width="100" Height="38"
                        Style="{StaticResource BotaoPadraoStyle}" Click="BotaoVoltarDiscos_Click"/>

                <TextBlock Grid.Column="1" Text="Informações dos Discos" FontSize="24"
                           FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Atualizar" Width="100" Height="38"
                        Style="{StaticResource BotaoPadraoStyle}" Click="BotaoAtualizarDiscos_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaDiscos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2B2B2B" BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Unidade:" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Unidade}" Foreground="White" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sistema de arquivos:" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SistemaArquivos}" Foreground="White"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Espaço total:" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EspacoTotal}" Foreground="White"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Espaço livre:" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EspacoLivre}" Foreground="White"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Espaço usado:" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EspacoUsado}" Foreground="White"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Uso:" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PercentualUso}" Foreground="White"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- PAINEL DO TERMINAL MAS OFFICE (NOVO) -->
        <Grid x:Name="PainelTerminalMas" Visibility="Collapsed" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Voltar" Width="100" Height="38"
                        Style="{StaticResource BotaoPadraoStyle}" Click="BotaoVoltarMas_Click"/>

                <TextBlock Grid.Column="1" Text="Ativação do Office (MAS Terminal)" FontSize="24"
                           FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Console de Saída do Terminal -->
            <Border Grid.Row="1" Background="Black" BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Padding="10">
                <TextBox x:Name="TxtConsoleMas" 
                         Background="Black" Foreground="#00FF00" 
                         FontFamily="Consolas" FontSize="13" 
                         BorderThickness="0"
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" 
                         TextWrapping="Wrap"/>
            </Border>

            <!-- Entrada de Comandos do Usuário -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                
                <!-->
                <TextBox x:Name="TxtInputComando" Grid.Column="0" Height="38" 
                         Background="#2B2B2B" Foreground="White" BorderBrush="#444444" 
                         FontSize="14" VerticalContentAlignment="Center" Padding="10,0"
                         KeyDown="TxtInputComando_KeyDown"/>

                <Button Grid.Column="1" Content="Enviar" Margin="10,0,0,0" Height="38"
                        Style="{StaticResource BotaoPadraoStyle}" Click="BtnEnviarOpcao_Click"/>
                <!-->
            </Grid>
        </Grid>

    </Grid>
</Page>