<Window x:Class="WindowsToolkit.Views.SelecionarCorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher cor"
        Width="420"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#202124">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Escolha a cor de destaque"
            FontSize="22"
            FontWeight="SemiBold"
            Foreground="White"
            Margin="0,0,0,24"/>

        <WrapPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Button Tag="#00BCD4"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

            <Button Tag="#2196F3"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

            <Button Tag="#3F51B5"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

            <Button Tag="#9C27B0"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

            <Button Tag="#E91E63"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

            <Button Tag="#F44336"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

            <Button Tag="#FF9800"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

            <Button Tag="#4CAF50"
                    Click="BotaoCor_Click"
                    Style="{StaticResource BotaoCorStyle}"/>

        </WrapPanel>

        <Button
            Grid.Row="2"
            Content="Cancelar"
            Width="100"
            Height="36"
            HorizontalAlignment="Right"
            Margin="0,20,0,0"
            Click="BotaoCancelar_Click"/>

    </Grid>
</Window>