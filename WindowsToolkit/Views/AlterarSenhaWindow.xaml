<Window x:Class="WindowsToolkit.Views.AlterarSenhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alterar senha"
        Width="430"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CorFundoPrincipal}">

    <Border Margin="30"
            Padding="30"
            Background="{DynamicResource CorPainel}"
            CornerRadius="15">

        <StackPanel>

            <TextBlock
                Text="Alterar senha"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource CorTextoPrincipal}"/>

            <TextBlock
                Text="Informe sua senha atual e escolha uma nova."
                Margin="0,5,0,25"
                TextWrapping="Wrap"
                Foreground="{DynamicResource CorTextoSecundario}"/>

            <TextBlock
                Text="Senha atual"
                Foreground="{DynamicResource CorTextoPrincipal}"/>

            <PasswordBox
                x:Name="SenhaAtualBox"
                Height="36"
                Margin="0,7,0,15"
                Padding="8,4"
                FontSize="16"/>

            <TextBlock
                Text="Nova senha"
                Foreground="{DynamicResource CorTextoPrincipal}"/>

            <PasswordBox
                x:Name="NovaSenhaBox"
                Height="36"
                Margin="0,7,0,15"
                Padding="8,4"
                FontSize="16"/>

            <TextBlock
                Text="Confirmar nova senha"
                Foreground="{DynamicResource CorTextoPrincipal}"/>

            <PasswordBox
                x:Name="ConfirmarSenhaBox"
                Height="36"
                Margin="0,7,0,20"
                Padding="8,4"
                FontSize="16"
                KeyDown="ConfirmarSenhaBox_KeyDown"/>

            <Button
                Content="Alterar senha"
                Height="45"
                Margin="0"
                Background="{DynamicResource CorDestaque}"
                Click="AlterarSenha_Click"
                Style="{StaticResource BotaoTemaStyle}"/>

        </StackPanel>

    </Border>
</Window>